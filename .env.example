# Copy to .env for running the app outside Docker. docker-compose.yml already sets these.
DOCINTEL_ENV=local
DOCINTEL_LOG_LEVEL=DEBUG
DOCINTEL_LOG_JSON=false

DOCINTEL_DB_HOST=localhost
DOCINTEL_DB_PORT=5433
DOCINTEL_DB_NAME=docintel
DOCINTEL_DB_USER=docintel
DOCINTEL_DB_PASSWORD=docintel
DOCINTEL_DB_SSL_MODE=disable

DOCINTEL_AWS_REGION=us-east-1
DOCINTEL_AWS_ENDPOINT_URL=http://localhost:5000
DOCINTEL_S3_BUCKET=docintel-local
DOCINTEL_SQS_JOBS_URL=http://localhost:5000/123456789012/docintel-local-jobs
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
