  "info": {
    "title": "DocIntel AI Engine",
    "version": "snapshot"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/extract": {
      "post": {
        "operationId": "extract_api_v1_extract_post",
        "parameters": [
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "async",
              "enum": [
                "async",
                "sync"
              ],
              "title": "Mode",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "description": "PDF, PNG or JPEG; max 25 MB (type is sniffed).",
                    "format": "binary",
                    "type": "string"
                  },
                  "options": {
                    "description": "Reserved JSON object of extraction options.",
                    "type": "string"
                  },
                  "schema_id": {
                    "examples": [
                      "invoice.v1"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "file",
                  "schema_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncExtractionResponse"
                }
              }
            },
            "description": "mode=sync: extraction result"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse",
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SubmitResponse"
                    },
                    {
                      "$ref": "#/components/schemas/SyncExtractionResponse"
                    }
                  ],
                  "title": "Response Extract Api V1 Extract Post"
                }
              }
            },
            "description": "mode=async: job accepted"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Extract",
        "tags": [
          "extraction"
        ]
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_api_v1_jobs__job_id__get",
